# Select one provider: deepseek, zhipu, minimax, openai, or mock.
# DeepSeek is the default page-chat provider. Mock is only for fallback/debug.
LLM_PROVIDER=deepseek

# LLM timeout and output length settings.
LLM_ENABLE_FALLBACK=true
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_CHARS=160

# DeepSeek OpenAI-compatible configuration.
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI-compatible optional voice/fallback configuration.
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_AUDIO_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_AUDIO_TTS_MODEL=gpt-4o-mini-tts
OPENAI_AUDIO_VOICE=sage

# Zhipu AI optional configuration.
ZHIPU_API_KEY=your_zhipu_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-4

# MiniMax optional LLM/TTS configuration.
MINIMAX_API_KEY=your_minimax_key_here
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_VOICE_ID=Chinese_female_young
